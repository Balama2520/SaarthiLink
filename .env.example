# ==============================================================================
# Saarthi AI Environment Variables Template
# ==============================================================================

# ── General Settings ──────────────────────────────────────────────────────────
APP_NAME="Saarthi AI"
VERSION="2.1.0"
DEBUG="false"
HOST="0.0.0.0"
PORT="2520"

# ── Security & Access ─────────────────────────────────────────────────────────
SECRET_KEY="your_secure_random_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"
ADMIN_USERNAMES="admin,guest,saarthi_admin"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE="120"
RATE_LIMIT_WINDOW_SECONDS="60"

# ── Database & Redis Cache ────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@hostname:5432/dbname"
REDIS_URL=""

# ── Supabase & Storage ────────────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="resumes"

# ── AI Engine (Google Gemini & Ollama) ────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OLLAMA_URL="http://localhost:11434/api/generate"
DEFAULT_MODEL="phi3"
OLLAMA_TIMEOUT="30"

# ── Integrations ──────────────────────────────────────────────────────────────
SAARTHI_CONTACT_EMAIL="saarthi.ai.team@gmail.com"
HF_SPACE_ID=""
HF_API_TOKEN=""
GOOGLE_SHEETS_SPREADSHEET_ID="1qPGJYxq_Nq-33xda4ZYA7DkX9pP2_VrMlWQAaviiI44"
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ── Frontend Configuration ────────────────────────────────────────────────────
VITE_API_BASE_URL="http://localhost:2520/api"
