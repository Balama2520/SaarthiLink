# ==============================================================================
# Saarthi AI OS Environment Variables (Template)
# ==============================================================================

# ── General Settings ──────────────────────────────────────────────────────────
APP_NAME="Saarthi AI OS"
VERSION="0.4.0-beta"

# Set to "false" in production
DEBUG="false"

# ── Security ──────────────────────────────────────────────────────────────────
# Must be set to a secure, randomly generated string in production
SECRET_KEY="replace_this_with_a_long_random_secure_string_in_production"
ALLOWED_ORIGINS="http://localhost,http://localhost:80,https://saarthi.example.com"

# ── Database & Redis ──────────────────────────────────────────────────────────
# Production Database (PostgreSQL)
DATABASE_URL="postgresql://saarthi:saarthi_pass@db:5432/saarthi"
# Local Development Database (SQLite)
# DATABASE_URL="sqlite:///./saarthi.db"

# Redis Cache connection
REDIS_URL="redis://redis:6379/0"

# ── External APIs ─────────────────────────────────────────────────────────────
# LLM Provider Key (e.g., OpenAI, Google, Anthropic)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
