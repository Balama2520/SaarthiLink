# ==============================================================================
# Saarthi AI Environment Variables Template (Render Production & Local Dev)
# ==============================================================================

# ── General Settings ──────────────────────────────────────────────────────────
APP_NAME="Saarthi AI"
VERSION="2.1.0"
DEBUG="false"
ENVIRONMENT="production"
HOST="0.0.0.0"
PORT="2520"

# ── Security & Access ─────────────────────────────────────────────────────────
SECRET_KEY="your-production-high-entropy-jwt-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"
ADMIN_USERNAMES="saarthiadmin,Balamaneesh2520"
ALLOWED_ORIGINS="https://saarthi-link.netlify.app,https://saarthilink.onrender.com,http://localhost:5173,http://localhost:3000"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE="120"
RATE_LIMIT_WINDOW_SECONDS="60"

# ── Database & Redis Cache ────────────────────────────────────────────────────
# Render/Supabase PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/saarthidb?sslmode=require"
REDIS_URL=""

# ── Supabase & Storage ────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
STORAGE_BUCKET="resumes"

# ── AI Engine (Google Gemini & Hugging Face) ──────────────────────────────────
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
OLLAMA_URL="http://localhost:11434/api/generate"
DEFAULT_MODEL="phi3"
OLLAMA_TIMEOUT="30"

# ── Integrations ──────────────────────────────────────────────────────────────
SAARTHI_CONTACT_EMAIL="saarthi.ai.team@gmail.com"
HF_SPACE_ID="Balamaneesh2520/saarthi-ai-brain"
HF_API_TOKEN="your-huggingface-api-token"
GOOGLE_SHEETS_SPREADSHEET_ID="1qPGJYxq_Nq-33xda4ZYA7DkX9pP2_VrMlWQAaviiI44"
GOOGLE_SERVICE_ACCOUNT_JSON="your-base64-or-json-service-account-key"

# ── Frontend Configuration (Netlify / Render Client) ──────────────────────────
# Set in Netlify Environment Variables:
VITE_API_BASE_URL="https://saarthilink.onrender.com/api"
