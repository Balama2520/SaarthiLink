# Security
# Generate a unique, high-entropy value for every environment. Do not use a default.
SECRET_KEY=""
# Comma-separated list of admin usernames, e.g. "saarthiadmin,rootadmin"
ADMIN_USERNAMES=""
# In production, set this to your frontend domains (comma-separated).
# Example: "https://your-app.netlify.app,http://localhost:5173"
# Do NOT use "*" in production.
ALLOWED_ORIGINS=""

# Rate Limiting
# Rate limiting is enabled by default to protect AI endpoints
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE="120"
RATE_LIMIT_WINDOW_SECONDS="60"

# AI Configuration
# Gemini is the production provider. Ollama is an optional local-development fallback.
# GEMINI_API_KEY stays server-side only. It NEVER goes to the browser bundle.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OLLAMA_URL="http://localhost:11434/api/generate"

# Database
# Production: Supabase PostgreSQL connection string (pooler recommended)
# Local dev: SQLite is fine
DATABASE_URL="sqlite:///./saarthi.db"

# Redis — OPTIONAL cache/memory layer.
# Core persistence NEVER requires Redis. If Redis is unreachable the app degrades
# gracefully (caching disabled, memory falls back to DB reads).
REDIS_URL="redis://localhost:6379/0"

# Supabase — Storage + Production DB (recommended)
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security on the backend.
# NEVER log it, NEVER send it to the browser, NEVER commit it to git.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket name. Bucket must be created in the Supabase dashboard BEFORE uploads
# work. Bucket should be PRIVATE — file URLs are served via signed URLs or by the backend.
STORAGE_BUCKET="resumes"

# ── Legacy storage env vars (kept for old callers) ──
# Prefer SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# Object storage. Supabase Storage in production.
STORAGE_URL=""
STORAGE_KEY=""

# HuggingFace Saarthi Brain Adapter Configuration (Secondary Provider)
HF_SPACE_ID=""
HF_API_TOKEN=""

# Google Sheets Live Connectivity Configuration (14-Tab Engine)
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# System Contact Email
SAARTHI_CONTACT_EMAIL="saarthi.ai.team@gmail.com"
