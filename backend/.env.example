# ==============================================================================
# Saarthi AI Backend Environment Variables (Render & Production Configuration)
# ==============================================================================

# Security
# Set ENVIRONMENT to "production" on Render
ENVIRONMENT="production"
SECRET_KEY="your-production-high-entropy-jwt-secret-key"
ADMIN_USERNAMES="saarthiadmin,Balamaneesh2520"

# CORS Configuration for Render Backend
# Include Netlify frontend, Render backend domain, and localhost
ALLOWED_ORIGINS="https://saarthi-link.netlify.app,https://saarthilink.onrender.com,http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE="120"
RATE_LIMIT_WINDOW_SECONDS="60"

# AI Configuration
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
OLLAMA_URL="http://localhost:11434/api/generate"

# Database
# Production: Supabase / PostgreSQL database URL
# Local dev: sqlite:///./saarthi.db
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Redis Cache (Optional)
REDIS_URL=""

# Supabase Storage & Database Connection
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
STORAGE_BUCKET="resumes"

# HuggingFace Saarthi Brain Model Configuration
HF_SPACE_ID="Balamaneesh2520/saarthi-ai-brain"
HF_API_TOKEN="your-huggingface-api-token"
HF_API_NAME="generate"

# Google Sheets Live Connectivity (14-Tab Engine)
GOOGLE_SHEETS_SPREADSHEET_ID="1qPGJYxq_Nq-33xda4ZYA7DkX9pP2_VrMlWQAaviiI44"
GOOGLE_SERVICE_ACCOUNT_JSON="your-base64-or-json-service-account-key"

# System Contact Email
SAARTHI_CONTACT_EMAIL="saarthi.ai.team@gmail.com"
